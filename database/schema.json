{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KhaliyaRestaurantDatabaseSchema",
  "description": "JSON Schema specification for Khaliya Restaurant MongoDB Collections",
  "collections": {
    "menu": {
      "type": "object",
      "properties": {
        "id": { "type": ["string", "number"] },
        "category": { "type": "string" },
        "name": { "type": ["string", "object"] },
        "description": { "type": ["string", "object"] },
        "price": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" }
      },
      "required": ["category", "name", "price"]
    },
    "bookings": {
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Seated", "Cancelled", "Completed"] },
        "source": { "type": "string" },
        "specialRequests": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "guests": { "type": "integer", "minimum": 1 },
        "tableType": { "type": "string" }
      },
      "required": ["name", "phone", "date", "time", "guests"]
    },
    "orders": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": ["number", "string"] },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "tableNumber": { "type": "string" },
        "source": { "type": "string" },
        "pointsUsed": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "email": { "type": "string" }
      },
      "required": ["id", "items", "total"]
    },
    "reviews": {
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "date": { "type": "string" },
        "name": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" }
      },
      "required": ["name", "rating"]
    },
    "users": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "joinedAt": { "type": "string" },
        "spicePoints": { "type": "number", "default": 0 },
        "role": { "type": "string", "default": "customer" },
        "currentSessionId": { "type": "string" }
      },
      "required": ["email"]
    },
    "tables": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "capacity": { "type": "number" },
        "tableType": { "type": "string" },
        "section": { "type": "string" },
        "status": { "type": "string" },
        "session": { "type": "object" },
        "mergedTables": { "type": "array", "items": { "type": "string" } },
        "mergedInto": { "type": "string" },
        "effectiveCapacity": { "type": "number" }
      },
      "required": ["id", "name", "capacity"]
    },
    "settings": {
      "type": "object",
      "properties": {
        "isOpen": { "type": "boolean", "default": true }
      }
    },
    "staff": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "pin": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "shift": { "type": "string" }
      },
      "required": ["name", "role", "pin"]
    },
    "shifts": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "shiftName": { "type": "string" },
        "openedAt": { "type": "string" },
        "closedAt": { "type": "string" },
        "openingFloat": { "type": "number" },
        "status": { "type": "string" },
        "cashSales": { "type": "number" },
        "expectedCash": { "type": "number" },
        "actualCash": { "type": "number" },
        "variance": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "printers": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "ip": { "type": "string" },
        "port": { "type": "number" },
        "paperWidth": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "audit_logs": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "staffName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "reason": { "type": "string" },
        "splits": { "type": "object" }
      }
    },
    "print_queue": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "ticketType": { "type": "string" },
        "payload": { "type": "object" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
